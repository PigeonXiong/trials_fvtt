<div class="trails chat-card damage-card">
  <header class="card-title">
    <i class="{{icon}}"></i>
    <span>{{title}}</span>
  </header>
  {{#if stats.length}}
  <div class="card-stats">{{#each stats}}<span>{{this}}</span>{{/each}}</div>
  {{/if}}
  <div class="card-band {{#if burst}}burst{{/if}}">// {{band}} //</div>

  <div class="card-roll-row">
    <img class="card-actor-img" src="{{actorImg}}" alt="">
    <div class="card-roll-main">
      <div class="card-actor-line"><span class="card-actor-name">{{actorName}}</span></div>
      <div class="dice-roll trails-roll">
        <div class="trails-roll-line">
          <span class="trails-formula">{{roll.formula}}</span>
          <span class="trails-total">{{roll.total}}</span>
        </div>
        {{{roll.tooltip}}}
      </div>
    </div>
  </div>

  {{#if destined}}
  <div class="card-destined"><i class="fa-solid fa-star"></i> {{localize "TRAILS.Destined.Gained"}}（{{destined}}）</div>
  {{/if}}
  {{#if tags.length}}
  <ul class="card-tags">{{#each tags}}<li>{{this}}</li>{{/each}}</ul>
  {{/if}}

  {{#if targets.length}}
  <ol class="card-targets damage-targets">
    {{#each targets}}
    <li class="card-target" data-target-index="{{@index}}">
      <img src="{{img}}" alt="">
      <span class="target-name">{{name}}</span>
      <span class="target-armor {{#if coverLabel}}covered{{/if}}" data-tooltip="{{armorTooltip}}">
        <i class="fa-solid fa-shield-halved"></i> {{armorTotal}}
      </span>
      <select class="damage-multiplier" data-tooltip="TRAILS.Damage.MultiplierHint">
        <option value="2">×2</option>
        <option value="1" selected>×1</option>
        <option value="0.5">×½</option>
      </select>
      <button type="button" class="target-apply" data-trails-action="applyTargetDamage" data-index="{{@index}}" data-tooltip="TRAILS.Damage.ApplyTargetHint">
        <i class="fa-solid fa-heart-crack"></i>
      </button>
    </li>
    {{/each}}
  </ol>
  {{/if}}
  <div class="card-buttons">
    <button type="button" data-trails-action="applyDamage" data-tooltip="TRAILS.Damage.ApplyHint"><i class="fa-solid fa-heart-crack"></i> {{localize "TRAILS.Damage.ApplySelected"}}</button>
  </div>
</div>
