<div class="trails chat-card action-card">
  <header class="card-title">
    {{#if itemImg}}<img class="card-item-img" src="{{itemImg}}" alt="">{{else}}<i class="{{icon}}"></i>{{/if}}
    <span>{{title}}</span>
  </header>
  {{#if stats.length}}
  <div class="card-stats">{{#each stats}}<span>{{this}}</span>{{/each}}</div>
  {{/if}}
  {{#if band}}<div class="card-band">// {{band}} //</div>{{/if}}

  {{#if roll}}
  <div class="card-roll-row">
    <img class="card-actor-img" src="{{actorImg}}" alt="">
    <div class="card-roll-main">
      <div class="card-actor-line">
        <span class="card-actor-name">{{actorName}}</span>
        {{#if resultLabel}}<span class="card-result {{#if outcome.success}}success{{else}}failure{{/if}}">{{resultLabel}}</span>{{/if}}
      </div>
      <div class="dice-roll trails-roll">
        <div class="trails-roll-line">
          <span class="trails-formula">{{roll.formula}}</span>
          <span class="trails-total">{{roll.total}}</span>
        </div>
        {{{roll.tooltip}}}
      </div>
    </div>
  </div>
  {{#if badges.length}}
  <div class="card-badges">{{#each badges}}<span class="card-badge {{cls}}">{{label}}</span>{{/each}}</div>
  {{/if}}

  {{#if targets.length}}
  <ol class="card-targets">
    {{#each targets}}
    <li class="card-target {{#if success}}hit{{else}}miss{{/if}}">
      <img src="{{img}}" alt="">
      <span class="target-name">{{name}}</span>
      {{#if coverLabel}}<span class="target-cover" data-tooltip="{{coverLabel}}"><i class="fa-solid fa-shield-halved"></i>{{#if coverGuard}} +{{coverGuard}}{{/if}}</span>{{/if}}
      <span class="target-vs">VS {{targetVS}}</span>
      <span class="target-result">{{resultLabel}}</span>
    </li>
    {{/each}}
  </ol>
  {{else if outcome.targetVS}}
  <div class="card-vs-line">{{localize "TRAILS.Roll.VS"}} {{outcome.targetVS}}{{#if outcome.chances}}（{{localize "TRAILS.Roll.Chances"}} ×{{outcome.chances}}）{{/if}}</div>
  {{else}}
  <div class="card-vs-line muted">{{localize "TRAILS.Roll.NoTarget"}}</div>
  {{/if}}
  {{/if}}

  {{#if destined}}
  <div class="card-destined"><i class="fa-solid fa-star"></i> {{localize "TRAILS.Destined.Gained"}}（{{destined}}）</div>
  {{/if}}
  {{#if tags.length}}
  <ul class="card-tags">{{#each tags}}<li>{{this}}</li>{{/each}}</ul>
  {{/if}}
  {{#if description}}
  <details class="card-description">
    <summary>{{localize "TRAILS.Sheet.Description"}}</summary>
    {{{description}}}
  </details>
  {{/if}}
  {{#if showDamage}}
  <button type="button" class="card-big-button" data-trails-action="damage">
    <i class="fa-solid fa-burst"></i> {{localize "TRAILS.Roll.Damage"}}{{#if damageCharges}}（+{{damageCharges}} {{localize "TRAILS.Roll.Charges"}}）{{/if}}
  </button>
  {{/if}}
</div>
