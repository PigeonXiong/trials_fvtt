<div class="form-grid">
  <label>{{localize "TRAILS.Item.Tree"}}
    <input type="text" name="system.tree" value="{{system.tree}}">
  </label>
  <label>{{localize "TRAILS.Item.Rank"}}
    <input type="number" name="system.rank" value="{{system.rank}}" min="0">
  </label>
  <label>{{localize "TRAILS.Item.SkillPointCost"}}
    <input type="number" name="system.cost" value="{{system.cost}}" min="0">
  </label>
</div>
<p class="hint">{{localize "TRAILS.Item.TalentHint"}}</p>
