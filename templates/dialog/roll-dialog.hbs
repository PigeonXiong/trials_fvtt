<div class="trails-roll-form">
  {{#if summary}}<p class="hint">{{summary}}</p>{{/if}}
  {{#if allowAbility}}
  <div class="form-group">
    <label>{{localize "TRAILS.Sheet.Ability"}}</label>
    <select name="ability">{{selectOptions abilityChoices selected=ability localize=true}}</select>
  </div>
  {{/if}}
  <div class="form-group">
    <label>{{localize "TRAILS.Roll.VS"}}</label>
    <input type="number" name="vs" value="{{vs}}" placeholder="{{localize 'TRAILS.Roll.VSPlaceholder'}}">
  </div>
  {{#if allowChances}}
  <div class="form-group">
    <label>{{localize "TRAILS.Roll.Chances"}}</label>
    <select name="chances" data-dtype="Number">{{selectOptions chanceChoices selected=0}}</select>
  </div>
  <p class="hint">{{localize "TRAILS.Roll.ChancesHint"}}</p>
  {{/if}}
  <div class="form-group">
    <label>{{localize "TRAILS.Roll.ExtraDice"}}</label>
    <input type="number" name="extraDice" value="0">
  </div>
  <div class="form-group">
    <label>{{localize "TRAILS.Roll.Charges"}}</label>
    <input type="number" name="charges" value="0" min="0">
  </div>
  <div class="form-group">
    <label>{{localize "TRAILS.Roll.Challenges"}}</label>
    <input type="number" name="challenges" value="0" min="0">
  </div>
  <div class="form-group">
    <label>{{localize "TRAILS.Roll.Flat"}}</label>
    <input type="number" name="flat" value="0">
  </div>
</div>
